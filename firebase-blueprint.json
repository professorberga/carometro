{
  "entities": {
    "alunos": {
      "title": "Alunos",
      "description": "Estudantes da escola",
      "type": "object",
      "properties": {
        "nomeCompleto": { "type": "string" },
        "ra": { "type": "string" },
        "turmaId": { "type": "string" },
        "fotoUrl": { "type": "string" },
        "numeroChamada": { "type": "number" }
      },
      "required": ["nomeCompleto", "ra", "turmaId"]
    },
    "turmas": {
      "title": "Turmas",
      "description": "Classes da escola",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "segmento": { "type": "string" },
        "periodo": { "type": "string" },
        "ano": { "type": "string" }
      },
      "required": ["nome"]
    }
  },
  "firestore": {
    "alunos": { "schema": "alunos", "description": "Coleção de alunos" },
    "turmas": { "schema": "turmas", "description": "Coleção de turmas" }
  }
}
